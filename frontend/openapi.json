  "components": {
    "schemas": {
      "CameraModeCommand": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "simulated",
              "physical"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "CameraModeCommand"
      },
      "CameraObservation": {
        "properties": {
          "observation_id": {
            "type": "string",
            "title": "Observation Id"
          },
          "camera_id": {
            "type": "string",
            "title": "Camera Id"
          },
          "stop_id": {
            "type": "string",
            "title": "Stop Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "simulated",
              "physical"
            ],
            "title": "Source"
          },
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Measured At"
          },
          "waiting_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Waiting Count"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "periodic",
              "pre_arrival",
              "post_departure"
            ],
            "title": "Trigger"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "visit_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visit Id"
          },
          "device_measured_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Measured At"
          }
        },
        "type": "object",
        "required": [
          "observation_id",
          "camera_id",
          "stop_id",
          "source",
          "measured_at",
          "waiting_count",
          "trigger"
        ],
        "title": "CameraObservation"
      },
      "ClockCommand": {
        "properties": {
          "speed": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 60.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          },
          "paused": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paused"
          }
        },
        "type": "object",
        "title": "ClockCommand"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryBucket": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "waiting_mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waiting Mean"
          },
          "onboard_percent_mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onboard Percent Mean"
          },
          "waiting_samples": {
            "type": "integer",
            "title": "Waiting Samples"
          },
          "vehicle_samples": {
            "type": "integer",
            "title": "Vehicle Samples"
          }
        },
        "type": "object",
        "required": [
          "label",
          "waiting_mean",
          "onboard_percent_mean",
          "waiting_samples",
          "vehicle_samples"
        ],
        "title": "HistoryBucket"
      },
      "HistoryStop": {
        "properties": {
          "stop_id": {
            "type": "string",
            "title": "Stop Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "mean_waiting": {
            "type": "number",
            "title": "Mean Waiting"
          },
          "peak_waiting": {
            "type": "integer",
            "title": "Peak Waiting"
          },
          "samples": {
            "type": "integer",
            "title": "Samples"
          }
        },
        "type": "object",
        "required": [
          "stop_id",
          "name",
          "mean_waiting",
          "peak_waiting",
          "samples"
        ],
        "title": "HistoryStop"
      },
      "HistorySummary": {
        "properties": {
          "waiting_mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waiting Mean"
          },
          "onboard_percent_mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onboard Percent Mean"
          },
          "high_load_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "High Load Percent"
          },
          "waiting_samples": {
            "type": "integer",
            "title": "Waiting Samples"
          },
          "vehicle_samples": {
            "type": "integer",
            "title": "Vehicle Samples"
          },
          "observed_stops": {
            "type": "integer",
            "title": "Observed Stops"
          }
        },
        "type": "object",
        "required": [
          "waiting_mean",
          "onboard_percent_mean",
          "high_load_percent",
          "waiting_samples",
          "vehicle_samples",
          "observed_stops"
        ],
        "title": "HistorySummary"
      },
      "HistoryView": {
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "source": {
            "type": "string",
            "const": "synthetic_history",
            "title": "Source",
            "default": "synthetic_history"
          },
          "available_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available From"
          },
          "available_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available To"
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "route_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route Id"
          },
          "stop_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Id"
          },
          "capacity_assumed": {
            "type": "integer",
            "title": "Capacity Assumed"
          },
          "summary": {
            "$ref": "#/components/schemas/HistorySummary"
          },
          "hourly": {
            "items": {
              "$ref": "#/components/schemas/HistoryBucket"
            },
            "type": "array",
            "title": "Hourly"
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/HistoryBucket"
            },
            "type": "array",
            "title": "Daily"
          },
          "busiest_stops": {
            "items": {
              "$ref": "#/components/schemas/HistoryStop"
            },
            "type": "array",
            "title": "Busiest Stops"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "generated_at",
